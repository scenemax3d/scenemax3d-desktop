var level1_camera_modifiers_paused=0
var level1_handheld_camera_step=0

hit_fx = camera.system.modifiers.hit_modifier
bump_fx = camera.system.modifiers.bump_modifier

fight_cam = camera.system.fighting(0, 0, depth 18, height 3, side 1.5, min distance 10, max distance 28, damping 8)

set_camera_on_player = {
  	
  if (player.network.id == fighter_slot1 || player.network.id == fighter_slot2) {
  	fight_cam = camera.system.fighting(fighter_slot1, fighter_slot2, 
  		depth 18, height 3, side 1.5, min distance 10, max distance 28, damping 8)
  	camera.system = fight_cam
  } else {
  	thrd_cam = camera.system.third_person(player.network.id, distance 12, height 3.4, 
  		side 4.5, look ahead 4, damping 7, fov 62, max fov 72)
  	camera.system = thrd_cam
  }

}

level1_switch_to_crystal_hunt_camera = {
  camera.chase stop
  camera_mode=CAMERA_MODE_DEFAULT
  run set_camera_on_player
}

[camera_mode==CAMERA_MODE_DEFAULT && level1_camera_modifiers_paused==0]
shake_the_world2 = {
	fight_cam.apply hit_fx
  fight_cam.apply bump_fx : duration 0.2, y 0.3
	
}


