
//////////////////////////  INPUT ///////////////////

[player.data.slot == 1 || player.data.slot == 2]
record_action (action) = {
	recorded_actions[rec_action_index] = action
	run display_recorded_action(action)
	if (rec_action_index == 4) {
	  rec_action_index = 0
	} else {
  	rec_action_index = rec_action_index + 1
	}
	
	audio.play "coin2"
}

var arrUI = [UI.layer1.panel1.panel_player1_action1, 
             UI.layer1.panel1.panel_player1_action1.player1_action1_text,
             UI.layer1.panel1.panel_player1_action2, 
             UI.layer1.panel1.panel_player1_action2.player1_action2_text,
             UI.layer1.panel1.panel_player1_action3, 
             UI.layer1.panel1.panel_player1_action3.player1_action3_text,
             UI.layer1.panel1.panel_player1_action4, 
             UI.layer1.panel1.panel_player1_action4.player1_action4_text,
             UI.layer1.panel1.panel_player1_action5, 
             UI.layer1.panel1.panel_player1_action5.player1_action5_text]
display_recorded_action(action) = {
	var index = (action-1)*2
	var panel = arrUI[rec_action_index]
	var txt = arrUI[rec_action_index+1]
	panel.Show
	txt.text = recorded_actions_desc[action-1] 
	panel.ease("EaseOutBounce", Right, 2)

}
             
