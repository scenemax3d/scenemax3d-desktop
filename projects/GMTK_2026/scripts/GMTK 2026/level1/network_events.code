
var is_executing = 0
[player.data.is_fighter == 1 && is_executing==0] // only actual fighter need to response to this 
network.on ("count", 5) = {
  is_executing = 1
  
  UI.layer1.txtCounter.text = "FIGHT!"
  
  if(rnd(3)==0){
    audio.play "fight1"
  } else if(rnd(20)==0){
    audio.play "attack1_jap"
  }
   
  run replay_action (recorded_actions[0])
  run replay_action (recorded_actions[1])
  run replay_action (recorded_actions[2])
  run replay_action (recorded_actions[3])
  run replay_action (recorded_actions[4])
  //recorded_actions.clear  
  recorded_actions[0] = 0
  recorded_actions[1] = 0
  recorded_actions[2] = 0
  recorded_actions[3] = 0
  recorded_actions[4] = 0
  rec_action_index = 0
  run display_recorded_actions
  is_executing = 0
  fight_counter = 6
  player.idle2
}

replay_action (action) = {
  if (action == 1) {
  	audio.play "kick3"
  	anim = animation player.mma_kick1 at speed of 2
  	anim.event("mma_kick1", 43) = {
  	  effective_hit = 1
  	}
  	anim.event("mma_kick1", 50) = {
  	  effective_hit = 0
  	}
  	anim.run

  } else if (action == 2) {
    audio.play "kick3"
    anim = animation player.hurricane_kick
    effective_hit = 1
    anim.run 
    effective_hit = 0
  } else if (action == 3) {
    anim = animation player.quad_punch1
    effective_hit = 1
    anim.run
    effective_hit = 0
  } else if (action == 4) {
    audio.play "kick3"
    anim = animation player.flying_kick
    anim.event("flying_kick", 22) = {
      audio.play "hu_ya1"
  	  effective_hit = 1
  	}
  	anim.event("flying_kick", 34) = {
  	  effective_hit = 0
  	}
    anim.run
  } else if (action == 5) {
    audio.play "kick3"
    anim = animation player.uppercut1
    anim.event("uppercut1", 26) = {
  	  effective_hit = 1
  	}
  	anim.event("uppercut1", 31) = {
  	  effective_hit = 0
  	}
    anim.run
  }
}

reduce_health = {

  if (player.data.slot == 1) {
	  player1_health = player1_health - 1
  } else if (player.data.slot == 2) {
		player2_health = player2_health - 1
  }
  
	is_hit = 0
	
	if (player.data.slot == 1 && player1_health <= 0) {
		run switch_player
	} else if (player.data.slot == 2 && player2_health <= 0) {
		run switch_player
	}

	
}

[is_hit == 0]
network.on ("head_hit_by_foot") = {
  is_hit = 1
  audio.play "hurt1"
	player.back_death1
	run reduce_health
}

[is_hit == 0]
network.on ("head_hit_by_hand") = {
  is_hit = 1
  audio.play "hurt1"
  player.back_death1
  run reduce_health
}

[is_hit == 0]
network.on ("body_hit_by_foot") = {
  is_hit = 1
  audio.play "hurt1"
	player.back_death1
	run reduce_health
}

[is_hit == 0]
network.on ("body_hit_by_hand") = {
  is_hit = 1
  audio.play "hurt1"
	player.back_death1
	run reduce_health
}

network.on ("new_player", name) = {
  audio.play "begin1"
  UI.layer1.panelMsg1.txt_msg1.text = name
  UI.layer1.panelMsg1.txt_msg2.text = "Joined!"
  UI.layer1.panelMsg1.ease("EaseOutBounce", Up, 5)
}

network.on("set_fighting_camera") = {
  run set_camera_on_player
}
