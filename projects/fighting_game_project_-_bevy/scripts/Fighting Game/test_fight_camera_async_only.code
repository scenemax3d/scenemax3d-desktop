// Split repro B: async hidden fighters, but no camera attach intro.
// If this breaks, the issue is async target readiness, not attach.

loading.print "Async-only fight camera test" : pos (80,10,0) , font "arial_64" , color=white, size 1
lights.add probe "4"

camera.system = default
camera.pos(8.015769,-8.97224,51.23)
camera.rotate(24.339067,126.80586,0.0)

floor => static box : size (80.0,1.0,80.0), pos (40.0,-89.6,22.0), material "wall", shadow mode cast

player1 => dynamic fighter1 : hidden, pos (40.0,-89.249504,30.0), scale 3.0, rotate(0.0,173.26024,0.0), shadow mode cast, collision shape none
, joints ("mixamorig:Head","mixamorig:LeftShoulder","mixamorig:LeftArm","mixamorig:LeftForeArm","mixamorig:LeftHand","mixamorig:RightShoulder","mixamorig:RightArm","mixamorig:RightForeArm","mixamorig:RightHand","mixamorig:LeftUpLeg","mixamorig:LeftLeg","mixamorig:LeftFoot","mixamorig:RightUpLeg","mixamorig:RightLeg","mixamorig:RightFoot") async

player2 => dynamic old_fighter2 : hidden, pos (40.0,-88.03695,16.5), scale 3.0, shadow mode on, collision shape none
, joints ("mixamorig:Head","mixamorig:LeftShoulder","mixamorig:LeftArm","mixamorig:LeftForeArm","mixamorig:LeftHand","mixamorig:RightShoulder","mixamorig:RightArm","mixamorig:RightForeArm","mixamorig:RightHand","mixamorig:LeftUpLeg","mixamorig:LeftLeg","mixamorig:LeftFoot","mixamorig:RightUpLeg","mixamorig:RightLeg","mixamorig:RightFoot") async

wait 1 seconds

player1.switch to character mode : gravity 60
player2.switch to character mode : gravity 40
player1.character.ignore player2.joints
player2.character.ignore player1.joints
player1.show
player2.show
player2.look at (player1)
player1.look at (player2)

fight_cam = camera.system.fighting(player1, player2, depth 18, height 3, side 1.5, min distance 10, max distance 28, damping 8)
loading.print "camera.system=fight_cam, async fighters, no attach" : pos (80,10,0) , font "arial_64" , color=yellow, size 1
camera.system = fight_cam

wait 30 seconds
