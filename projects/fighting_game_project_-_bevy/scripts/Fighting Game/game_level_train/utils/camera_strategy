var train_handheld_camera_step=0

hit_fx = camera.system.modifiers.hit_modifier
bump_fx = camera.system.modifiers.bump_modifier

fight_cam = camera.system.fighting(player1, player2, depth 32, height 5.6, side 4.2, min distance 22, max distance 52, damping 5)
player1_follow_cam = camera.system.third_person(player1, distance 15, height 2.8, side 3.8, look ahead 2.5, damping 6, fov 68, max fov 76)

[camera_mode==CAMERA_MODE_DEFAULT && train_camera_cycle_guard==0]
set_camera_on_player = {
  camera.attach stop
  camera.system = fight_cam
}

[camera_mode==CAMERA_MODE_DEFAULT && train_camera_cycle_guard==0]
shake_the_world = {
  fight_cam.apply hit_fx : duration 0.4, amplitude 1.55, frequency 1.2, x 0.16, y 0.22, ry 1.1, rz 1.9, fov 0.35
}

[camera_mode==CAMERA_MODE_DEFAULT && train_camera_cycle_guard==0]
shake_the_world2 = {
  fight_cam.apply bump_fx : duration 0.28, amplitude 1.1, x 0.2, y 0.18, z 0.06, rz 1.5
}

[camera_mode==CAMERA_MODE_DEFAULT && train_camera_cycle_guard==0]
train_respawn_camera_hit = {
  fight_cam.apply hit_fx : duration 0.26, amplitude 1.7, frequency 1.25, y 0.24, z 0.08, rz 1.8, fov 0.4
  fight_cam.apply bump_fx : duration 0.22, amplitude 1.15, x 0.18, y 0.2, z 0.08, rz 1.6
}

train_ringout_cinematic_player1 = {
  train_camera_cycle_guard=1
  camera_mode=TRAIN_CAMERA_MODE_RINGOUT
  cincam1=>cinematic.camera.cinematic1
  cincam1.play : target (player1 forward 1 up 3), duration 2.8

  camera_mode=CAMERA_MODE_DEFAULT
  train_camera_cycle_guard=0
  run set_camera_on_player
  run train_resume_after_fall
}

train_ringout_cinematic_player2 = {
  train_camera_cycle_guard=1
  camera_mode=TRAIN_CAMERA_MODE_RINGOUT
  cincam1=>cinematic.camera.cinematic1
  cincam1.play : target (player2 forward 1 up 3), duration 2.8

  camera_mode=CAMERA_MODE_DEFAULT
  train_camera_cycle_guard=0
  run set_camera_on_player
  run train_resume_after_fall
}

train_player1_third_person = {
  if(game_status!=GAME_STATE_START || train_ringout==1 || train_camera_cycle_guard==1) {
    return
  }

  train_camera_cycle_guard=1
  camera_mode=TRAIN_CAMERA_MODE_THIRD_PERSON
  camera.attach stop
  camera.system = player1_follow_cam
  wait 2.2 seconds
  camera.attach stop
  camera_mode=CAMERA_MODE_DEFAULT
  train_camera_cycle_guard=0
  run set_camera_on_player
}

run train_player1_third_person every 12 seconds

[camera_mode==CAMERA_MODE_DEFAULT && game_status==GAME_STATE_START && train_camera_cycle_guard==0 && train_ringout==0 && player1_ko==0 && enemy_ko==0]
train_handheld_phone_camera = {
  train_handheld_camera_step = train_handheld_camera_step + 1
  if(train_handheld_camera_step % 4 == 0) {
    fight_cam.apply bump_fx : duration 0.38, amplitude 0.82, x 0.09, y 0.14, z 0.04, ry -0.22, rz -1.35, fov 0.14
  } else if(train_handheld_camera_step % 4 == 1) {
    fight_cam.apply bump_fx : duration 0.32, amplitude 0.55, x -0.045, y 0.09, z 0.025, ry 0.12, rz -0.48, fov 0.08
  } else if(train_handheld_camera_step % 4 == 2) {
    fight_cam.apply bump_fx : duration 0.38, amplitude 0.82, x -0.09, y 0.14, z 0.04, ry 0.22, rz 1.35, fov 0.14
  } else {
    fight_cam.apply bump_fx : duration 0.32, amplitude 0.55, x 0.045, y 0.09, z 0.025, ry -0.12, rz 0.48, fov 0.08
  }
}

run train_handheld_phone_camera every 0.34 seconds
