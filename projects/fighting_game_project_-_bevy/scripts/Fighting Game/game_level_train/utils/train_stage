    if(game_status==GAME_STATE_START && train_ringout==0 && train_respawn_lock==0 && train_camera_cycle_guard==0 && player1_ko==0 && enemy_ko==0 && player1.data.celebrating==0) {
      if(camera_mode==CAMERA_MODE_DEFAULT && train_camera_cycle_guard==0) {
        run shake_the_world2
        if(rnd(6) == 0) {
          run shake_the_world
        }
      }
    }
  while train_stage_started==1

  do async
    wait 3.2 seconds
    if(game_status==GAME_STATE_START && train_ringout==0 && train_respawn_lock==0 && train_camera_cycle_guard==0 && player1_ko==0 && enemy_ko==0 && player1.data.celebrating==0 && rnd(3) == 0) {
      run train_upper_parts_big_hit
    }
  while train_stage_started==1
}

