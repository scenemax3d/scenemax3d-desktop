train_resume_after_fall = {
  camera_mode=CAMERA_MODE_DEFAULT
  train_camera_cycle_guard=0
  run set_camera_on_player
  train_respawn_lock=1

  player1.clear character mode
  player2.clear character mode

  if(train_player1_fall_pending==1) {
    player1.pos (40,-54,25.8)
    player2.pos (40,-86.9,19.8)
    player2.switch to character mode : gravity 40
    player2.look at (player1)
    player2.Idle loop

    run train_respawn_entry_fx_player1 Async
    wait 0.06 seconds
    player1.switch to character mode : gravity 180
    player1.look at (player2)

    game_status=GAME_STATE_START
    train_ringout=0

    do
      wait 0.04 seconds
    while player1.y > -87.05

    player1.clear character mode
    player1.pos (40,-87.4,25.8)
    wait 0.04 seconds
    player1.switch to character mode : gravity 60
    player1.look at (player2)
    audio.play "crash1"
    run train_respawn_landing_fx_player1 Async
    run train_respawn_camera_hit
    player1.idle2 loop
  } else if(train_player2_fall_pending==1) {
    player1.pos (40,-87.4,25.8)
    player2.pos (40,-54,19.8)
    player1.switch to character mode : gravity 60
    player1.look at (player2)
    player1.idle2 loop

    run train_respawn_entry_fx_player2 Async
    wait 0.06 seconds
    player2.switch to character mode : gravity 180
    player2.look at (player1)

    game_status=GAME_STATE_START
    train_ringout=0

    do
      wait 0.04 seconds
    while player2.y > -86.55

    player2.clear character mode
    player2.pos (40,-86.9,19.8)
    wait 0.04 seconds
    player2.switch to character mode : gravity 40
    player2.look at (player1)
    audio.play "crash1"
    run train_respawn_landing_fx_player2 Async
    run train_respawn_camera_hit
    player2.Idle loop
  } else {
    run train_reset_fighters_to_center
    game_status=GAME_STATE_START
    train_ringout=0
  }

  wait 0.45 seconds
  train_player1_fall_pending=0
  train_player2_fall_pending=0
  train_respawn_lock=0
}

