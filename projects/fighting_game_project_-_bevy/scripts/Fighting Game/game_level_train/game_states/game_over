game_over = {

  if(game_status==GAME_STATE_OVER) {
    return
  }

  game_status=GAME_STATE_OVER
  run train_stage_stop
  wait 0.1 seconds
  UI.layer1.panelMsg.txtMsg.message("GAME OVER", TextEffect.fade_in | TextEffect.zoom_in, 2) Async

  player2.look at (player1)
  player2.BackFlip
  player2.Idle loop
	wait 1.5 second 
  UI.layer1.panelMsg.txtSubMessage.text = "PRESS SPACE TO CONTINUE"

  wait for key space to be pressed
  UI.layer1.panelMsg.txtSubMessage.text = ""
  UI.layer1.panelMsg.txtMsg.text = ""

  run restart_game
}

[game_status==GAME_STATE_OVER]
restart_game = {

  player1.clear character mode
  player2.clear character mode

  player1.idle2 loop
  player2.Idle loop
  UI.layer1.panelMsg.txtMsg.text = ""
  UI.layer1.panelMsg.txtSubMessage.text = ""

  run game_start
}
