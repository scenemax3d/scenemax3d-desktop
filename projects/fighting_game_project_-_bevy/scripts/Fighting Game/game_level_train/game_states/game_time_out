time_out = {

  if(game_status==GAME_STATE_OVER) {
    return
  }

  game_status=GAME_STATE_OVER
  run train_stage_stop

  UI.layer1.panelMsg.txtMsg.message("TIME OUT", TextEffect.fade_in | TextEffect.zoom_in, 2) Async

  player1.victory
  player1.idle2 loop

  player2.Backflip
  player2.look at (player1)
  player2.Idle loop

  UI.layer1.panelMsg.txtSubMessage.text = "PRESS SPACE TO CONTINUE"

  wait for key space to be pressed
  UI.layer1.panelMsg.txtSubMessage.text = ""
  UI.layer1.panelMsg.txtMsg.text = ""

  run restart_game
}
