// Minimal level1-position fight camera test.
// Visible, synchronous fighters. No attach, no async, no hidden/show transition.

loading.print "Level1 positions only fight camera test" : pos (80,10,0) , font "arial_64" , color=white, size 1
lights.add probe "4"

camera.system = default
camera.pos(8.015769,-8.97224,51.23)
camera.rotate(24.339067,126.80586,0.0)

floor => static box : size (80.0,1.0,80.0), pos (40.0,-89.6,22.0), material "wall", shadow mode cast

player1 => dynamic fighter1 : pos (40.0,-89.249504,30.0), scale 3.0, rotate(0.0,173.26024,0.0), shadow mode cast, collision shape none
, joints ("mixamorig:Head","mixamorig:LeftShoulder","mixamorig:LeftArm","mixamorig:LeftForeArm","mixamorig:LeftHand","mixamorig:RightShoulder","mixamorig:RightArm","mixamorig:RightForeArm","mixamorig:RightHand","mixamorig:LeftUpLeg","mixamorig:LeftLeg","mixamorig:LeftFoot","mixamorig:RightUpLeg","mixamorig:RightLeg","mixamorig:RightFoot")

player2 => dynamic old_fighter2 : pos (40.0,-88.03695,16.5), scale 3.0, shadow mode on, collision shape none
, joints ("mixamorig:Head","mixamorig:LeftShoulder","mixamorig:LeftArm","mixamorig:LeftForeArm","mixamorig:LeftHand","mixamorig:RightShoulder","mixamorig:RightArm","mixamorig:RightForeArm","mixamorig:RightHand","mixamorig:LeftUpLeg","mixamorig:LeftLeg","mixamorig:LeftFoot","mixamorig:RightUpLeg","mixamorig:RightLeg","mixamorig:RightFoot")

player1.switch to character mode : gravity 60
player2.switch to character mode : gravity 40
player1.character.ignore player2.joints
player2.character.ignore player1.joints
player1.look at (player2)
player2.look at (player1)

fight_cam = camera.system.fighting(player1, player2, depth 18, height 3, side 1.5, min distance 10, max distance 28, damping 8)
camera.attach stop
camera.system = fight_cam

loading.print "Visible sync fighters at level1 positions should be framed" : pos (80,10,0) , font "arial_64" , color=yellow, size 1

do async
  wait 3 seconds
  loading.print "Phase 1: level1 fighters spread apart" : pos (80,10,0) , font "arial_64" , color=yellow, size 1
  player1.pos (34.0,-84.8,30.0)
  player2.pos (46.0,-83.8,14.0)
  player1.look at (player2)
  player2.look at (player1)

  wait 4 seconds
  loading.print "Phase 2: close together" : pos (80,10,0) , font "arial_64" , color=yellow, size 1
  player1.pos (38.0,-84.8,25.0)
  player2.pos (42.0,-83.8,20.0)
  player1.look at (player2)
  player2.look at (player1)

  wait 4 seconds
  loading.print "Phase 3: swap sides" : pos (80,10,0) , font "arial_64" , color=yellow, size 1
  player1.pos (50.0,-84.8,31.0)
  player2.pos (30.0,-83.8,13.0)
  player1.look at (player2)
  player2.look at (player1)
end do

wait 35 seconds
