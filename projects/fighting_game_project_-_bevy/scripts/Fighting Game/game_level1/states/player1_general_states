

when player1_ko == 1 do
    
  do async
		wait 0.5 seconds
		audio.play "crash1"
  end do
  
  do async
    player1.shader = "bv_dramatic_hit_red"//"dramatic_hit";
	  wait 1 second
	  player1.shader = "";
	end do
		
	if(rnd(2)==0) {
		player1.back_death1 at speed of 1.2 : protected
	} else {
		player1.right_death1 at speed of 1.2: protected
	}

	wait 1 seconds
	
	player1.standing_up at speed of 1.2 : protected
	player1.idle2 loop
	
	player1_ko=0
	
end do
	
