// Fight camera smoke test that mimics the game_level1 intro camera path.
// Key check: camera is attached to tg first, then camera.system is changed to fighting without camera.attach stop.

loading.print "Level1 intro camera test: loading" : pos (80,10,0) , font "arial_64" , color=white, size 1
lights.add probe "4"

camera.system = default
camera.pos(8.015769,-8.97224,51.23)
camera.rotate(24.339067,126.80586,0.0)

floor => static box : size (80.0,1.0,80.0), pos (40.0,-89.6,22.0), material "wall", shadow mode cast
left_marker => static box : size (1.0,1.0,1.0), pos (28.0,-88.6,31.0), material "grass", collision shape none
right_marker => static box : size (1.0,1.0,1.0), pos (52.0,-88.6,13.0), material "rock", collision shape none
middleSphere is a sphere : hidden and radius 0.1 and material="alpha"

tg => tiger3: pos (13.0,-14.0,43.0), scale 0.04, rotate(0.0,-179.99998,0.0), shadow mode on async
boss => boss : hidden, pos (9.0,0.0,35.0), scale 3.0, shadow mode cast, collision shape none async
tg."Idle_Lie Prone" loop

loading.print "Phase 0: camera attached to tiger" : pos (80,10,0) , font "arial_64" , color=yellow, size 1
camera.attach to tg : pos (0,1,-12)

wait 3 seconds

player1 => dynamic fighter1 : hidden, pos (40.0,-89.249504,30.0), scale 3.0, rotate(0.0,173.26024,0.0), shadow mode cast, collision shape none
, joints ("mixamorig:Head","mixamorig:LeftShoulder","mixamorig:LeftArm","mixamorig:LeftForeArm","mixamorig:LeftHand","mixamorig:RightShoulder","mixamorig:RightArm","mixamorig:RightForeArm","mixamorig:RightHand","mixamorig:LeftUpLeg","mixamorig:LeftLeg","mixamorig:LeftFoot","mixamorig:RightUpLeg","mixamorig:RightLeg","mixamorig:RightFoot") async

player2 => dynamic old_fighter2 : hidden, pos (40.0,-88.03695,16.5), scale 3.0, shadow mode on, collision shape none
, joints ("mixamorig:Head","mixamorig:LeftShoulder","mixamorig:LeftArm","mixamorig:LeftForeArm","mixamorig:LeftHand","mixamorig:RightShoulder","mixamorig:RightArm","mixamorig:RightForeArm","mixamorig:RightHand","mixamorig:LeftUpLeg","mixamorig:LeftLeg","mixamorig:LeftFoot","mixamorig:RightUpLeg","mixamorig:RightLeg","mixamorig:RightFoot") async

wait 1 seconds

player1.switch to character mode : gravity 60
player2.switch to character mode : gravity 40
player1.character.ignore player2.joints
player2.character.ignore player1.joints

tg.switch to character mode
tg.turn right 45 in 0.1 seconds
tg.hide

player1.show
player2.show
player2.look at (player1)
player1.look at (player2)

fight_cam = camera.system.fighting(player1, player2, depth 18, height 3, side 1.5, min distance 10, max distance 28, damping 8)

loading.print "Phase 1: camera.system=fight_cam, no attach stop" : pos (80,10,0) , font "arial_64" , color=yellow, size 1
camera.system = fight_cam

do async
  wait 4 seconds
  loading.print "Phase 2: fighters spread apart" : pos (80,10,0) , font "arial_64" , color=yellow, size 1
  player1.pos (24.0,-84.8,34.0)
  player2.pos (56.0,-83.8,10.0)
  player1.look at (player2)
  player2.look at (player1)

  wait 4 seconds
  loading.print "Phase 3: fighters close together" : pos (80,10,0) , font "arial_64" , color=yellow, size 1
  player1.pos (39.0,-84.8,23.0)
  player2.pos (41.0,-83.8,21.0)
  player1.look at (player2)
  player2.look at (player1)

  wait 4 seconds
  loading.print "Phase 4: attach to boss briefly" : pos (80,10,0) , font "arial_64" , color=yellow, size 1
  boss.pos (40.0,-84.5,22.0)
  boss.show
  boss.look at (player1)
  camera.attach to boss : pos (0,2,-8)

  wait 3 seconds
  loading.print "Phase 5: return to fighting camera again" : pos (80,10,0) , font "arial_64" , color=yellow, size 1
  camera.system = fight_cam

  wait 6 seconds
  loading.print "Level1 intro camera test complete" : pos (80,10,0) , font "arial_64" , color=green, size 1
end do

wait 45 seconds
