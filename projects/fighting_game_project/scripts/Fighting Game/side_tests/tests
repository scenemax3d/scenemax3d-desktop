
axe=>meshy_axe : pos (0,0,0)
player1 => fighter1 : pos (4,0,0)


flash_axe = {
	if (axe.data.axe_flash == 1) {
	  axe.shader = "dramatic_hit_red"
	  axe.data.axe_flash = 0
	} else {
		axe.shader = ""
		axe.data.axe_flash = 1
	}
}

axe_lookup = {
	
	axe.Show
	axe.turn 360 in 1 second loop while 1==1
	run flash_axe every 0.5 Seconds
	player1.weapon = "weapon_player_weapon"
//
//	[player1.data.throw_axe == 1]
//	when weapon_sphere_collider_1 collides with crystal_box do
//		crystal_box.hide
//		crystal.Show
//    crystal.turn left 360 in 1 Seconds Loop while 1==1 
//	end do
	 
	when key Q is pressed once do
	  Logger.info "side test Q: preparing zombie_punch1"
	  player1.weapon.posture = "fight"
	  anim = animation player1.zombie_punch1
	  anim.event("zombie_punch1", 30) = {
	    Logger.info "side test Q: zombie_punch1 30 percent event"
	  	player1.data.throw_axe = 1
		  player1.weapon.Detach
		  weapon_player_weapon.move forward 5 in 0.5 seconds
		  player1.data.throw_axe = 0
	  }
	  Logger.info "side test Q: running zombie_punch1"
	  anim.run
	  Logger.info "side test Q: zombie_punch1 finished"
	end do 
}

run axe_lookup
