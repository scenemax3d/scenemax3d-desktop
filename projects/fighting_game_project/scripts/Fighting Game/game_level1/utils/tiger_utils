tiger_roar(tm) = {
	audio.play "monster_roar"
  tg.Howl async
  camera.attach to tg : pos (0,1,-12)
	wait tm seconds
	run set_camera_on_player
}

level1_dragon_rock_push_player2 = {
  do async
    player2_hit1.pos(player2."mixamorig:Head") 
    player2_hit1.show
    player2_hit1.play (frame 0 to 15) 
    player2_hit1.hide
  end do

  audio.play "hurt1"
  player2."Hit" async
  player2.move backward 4.0 for 0.25 seconds
}

level1_dragon_rock_hit_players(r) = {
  if(distance(player1, r) < 8.0 && player1_ko==0 && game_status==GAME_STATE_START && level1_dragon_rock_player1_hit_guard==0) {
    level1_dragon_rock_player1_hit_guard=1
    run player1_head_hit Async
    run shake_the_world2 async
    do async
      wait 0.85 seconds
      level1_dragon_rock_player1_hit_guard=0
    end do
  }

  if(distance(player2, r) < 8.0 && enemy_ko==0 && game_status==GAME_STATE_START && level1_dragon_rock_player2_hit_guard==0) {
    level1_dragon_rock_player2_hit_guard=1
    run level1_dragon_rock_push_player2 Async
    run shake_the_world2 async
    do async
      wait 0.85 seconds
      level1_dragon_rock_player2_hit_guard=0
    end do
  }
}

level1_dragon_rock_explode(r) = {
  var rock_fx_x = r.x
  var rock_fx_y = r.y
  var rock_fx_z = r.z

  //Logger.info "DRAGON_ROCK cleanup start x=" + rock_fx_x + " y=" + rock_fx_y + " z=" + rock_fx_z
  run level1_dragon_rock_hit_players(r)
  wait 0.12 seconds
  r.hide
  r.delete
  //Logger.info "DRAGON_ROCK rock delete done x=" + rock_fx_x + " y=" + rock_fx_y + " z=" + rock_fx_z

  burst_fx => effects.effekseer.Simple_Distortion_2
  spark_fx => effects.effekseer.Simple_Sprite_BillBoard
  ring_fx => effects.effekseer.Simple_Ring_Shape1

  burst_fx.play pos (rock_fx_x,rock_fx_y,rock_fx_z) Async
  spark_fx.play pos (rock_fx_x,rock_fx_y,rock_fx_z) Async
  ring_fx.play pos (rock_fx_x,rock_fx_y,rock_fx_z) Async
  audio.play "crash1"

  if(camera_mode==CAMERA_MODE_DEFAULT) {
    run shake_the_world async
  }

  wait 0.6 seconds
  burst_fx.delete
  spark_fx.delete
  ring_fx.delete
  //Logger.info "DRAGON_ROCK effect delete done x=" + rock_fx_x + " y=" + rock_fx_y + " z=" + rock_fx_z
}

level1_dragon_rock_clear_slot(slot_id) = {
  if(slot_id==1) {
    level1_dragon_rock_slot_1=0
  } else if(slot_id==2) {
    level1_dragon_rock_slot_2=0
  } else if(slot_id==3) {
    level1_dragon_rock_slot_3=0
  } else if(slot_id==4) {
    level1_dragon_rock_slot_4=0
  } else if(slot_id==5) {
    level1_dragon_rock_slot_5=0
  }
}

level1_watch_physics_dragon_gate_rock(r, slot_id) = {
  var rock_age = 0
  var rock_landed = 0

  do
    if(game_status!=GAME_STATE_START || level1_dragon_rocks_started==0 || r.y < -125.0) {
      run level1_dragon_rock_clear_slot(slot_id)
      run level1_dragon_rock_explode(r)
      level1_dragon_rock_count=level1_dragon_rock_count-1
      return
    }

    if(distance(player1, r) < 8.0 || distance(player2, r) < 8.0) {
      run level1_dragon_rock_hit_players(r)
      run level1_dragon_rock_clear_slot(slot_id)
      run level1_dragon_rock_explode(r)
      level1_dragon_rock_count=level1_dragon_rock_count-1
      return
    }

    if(rock_landed==0 && r.y < -84.0) {
      rock_landed=1
      audio.play "crash1"
      run shake_the_world2 async
    }

    wait 0.08 seconds
    rock_age=rock_age+0.08
  while rock_age < 5.75

  run level1_dragon_rock_clear_slot(slot_id)
  run level1_dragon_rock_explode(r)
  level1_dragon_rock_count=level1_dragon_rock_count-1
}

level1_launch_dragon_gate_rock_1 = {
  level1_dragon_rock_slot_1=1
  level1_dragon_rock_count=level1_dragon_rock_count+1

  // Ballistic throw motion gives a fast arc toward player1; box collision avoids mesh spawn hitches.
  var level1_dragon_rock_1_scale = 1.56 + rnd(365) * 0.01
  var level1_dragon_rock_1_target_x = player1.x + rnd(21) - 10
  var level1_dragon_rock_1_target_y = player1.y + 1.5
  var level1_dragon_rock_1_target_z = player1.z + rnd(21) - 10
  if(player1.z > 70.0) {
    level1_dragon_rock_1_target_y = player1.y + 11.0
    level1_dragon_rock_1_target_z = player1.z - 18.0 + rnd(13) - 6
  }
  dragon_gate_rock_1 => meshy_rock1 : pos (17.0,-57.0,96.0), scale level1_dragon_rock_1_scale, rotate(0.0,18.0,0.0), shadow mode on, collision shape box
  level1_dragon_rock_1_motion = system.motion("motion_dragon_gate_rock", target (level1_dragon_rock_1_target_x,level1_dragon_rock_1_target_y,level1_dragon_rock_1_target_z))
  level1_dragon_rock_1_motion.apply dragon_gate_rock_1 async
  dragon_gate_rock_1.roll right 2400 in 5.75 seconds async
  run level1_watch_physics_dragon_gate_rock(dragon_gate_rock_1, 1)
}

