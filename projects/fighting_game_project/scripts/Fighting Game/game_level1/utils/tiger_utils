level1_spawn_dragon_gate_rock = {
  if(level1_dragon_rocks_started==0 || game_status!=GAME_STATE_START || level1_dragon_rock_count>=5) {
    return
  }

  if(level1_dragon_rock_slot_1==0) {
    run level1_launch_dragon_gate_rock_1 Async
  } else if(level1_dragon_rock_slot_2==0) {
    run level1_launch_dragon_gate_rock_2 Async
  } else if(level1_dragon_rock_slot_3==0) {
    run level1_launch_dragon_gate_rock_3 Async
  } else if(level1_dragon_rock_slot_4==0) {
    run level1_launch_dragon_gate_rock_4 Async
  } else if(level1_dragon_rock_slot_5==0) {
    run level1_launch_dragon_gate_rock_5 Async
  }
}

level1_dragon_rocks_start = {
  if(level1_dragon_rocks_started==1 || game_status!=GAME_STATE_START) {
    return
  }

  level1_dragon_rocks_started=1
  run level1_spawn_dragon_gate_rock
  do async
    wait 1.15 seconds
    do
      run level1_spawn_dragon_gate_rock
      wait 1.15 seconds
    while level1_dragon_rocks_started==1
  end do
}

level1_dragon_rocks_stop = {
  level1_dragon_rocks_started=0
  level1_dragon_rock_player1_hit_guard=0
  level1_dragon_rock_player2_hit_guard=0
}
